<Window x:Class="MiningOps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:viewModels="clr-namespace:MiningOps.ViewModels"
		xmlns:views="clr-namespace:MiningOps.Views"
		xmlns:converters="clr-namespace:MiningOps.Converters"
        xmlns:local="clr-namespace:MiningOps"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
        Title="MiningOps - Municipal &amp; Mining Operations Management System" 
        Height="800" Width="1200" 
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Converters -->
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:RoleToColorConverter x:Key="RoleToColorConverter"/>
        <converters:QuantityToStatusConverter x:Key="QuantityToStatusConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrencyConverter"/>
        <converters:DateTimeToShortDateConverter x:Key="DateTimeToShortDateConverter"/>
        <converters:ReadNotificationToBackgroundConverter x:Key="ReadNotificationToBackgroundConverter"/>
        <converters:DateTimeToReadableConverter x:Key="DateTimeToReadableConverter"/>
        <converters:PriorityToColorConverter x:Key="PriorityToColorConverter"/>
        <converters:ReadStatusToTextConverter x:Key="ReadStatusToTextConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataTemplates for View switching -->
        <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UserManagementViewModel}">
            <views:UserManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InventoryManagementViewModel}">
            <views:InventoryManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:OrderManagementViewModel}">
            <views:OrderManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PaymentProcessingViewModel}">
            <views:PaymentProcessingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SupplierManagementViewModel}">
            <views:SupplierManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RequestManagementViewModel}">
            <views:RequestManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SupplierDashboardViewModel}">
            <views:SupplierDashboardView/>
        </DataTemplate>
        <!-- NEW: Add NotificationsViewModel DataTemplate -->
        <DataTemplate DataType="{x:Type viewModels:NotificationsViewModel}">
            <views:NotificationsView/>
        </DataTemplate>

        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="DropShadowEffect" 
                     BlurRadius="10" 
                     ShadowDepth="2" 
                     Color="#33000000"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar - Only show when logged in -->
        <Border Grid.Column="0" 
                Background="#F5F5F5" 
                BorderThickness="0,0,1,0" 
                BorderBrush="#E0E0E0"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel>
                <!-- Logo -->
                <Border Background="#1976D2" Height="80" Padding="20">
                    <TextBlock Text="MiningOps" 
                              Foreground="White" 
                              FontSize="18" 
                              FontWeight="Bold" 
                              VerticalAlignment="Center"/>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel Margin="10" Grid.IsSharedSizeScope="True">
                    <!-- Common Navigation -->
                    <Button Content="📊 Dashboard" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Dashboard"/>

                    <!-- Admin-only navigation -->
                    <Button Content="👥 User Management" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="UserManagement"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="📦 Inventory" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Inventory"
                            Visibility="{Binding IsAdminOrSupervisor, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="🏢 Suppliers" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Suppliers"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="📋 Requests" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Requests"
                            Visibility="{Binding IsAdminOrSupervisor, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="🛒 Orders &amp; Procurement" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Orders"
                            Visibility="{Binding IsAdminOrSupervisor, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="💳 Payment Processing" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Payments"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- NEW: Notifications Page (All Roles) -->
                    <Button Content="🔔 Notifications" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Notifications"/>

                    <!-- Supplier-only navigation -->
                    <Button Content="🏠 Supplier Portal" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="SupplierPortal"
                            Visibility="{Binding IsSupplier, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="📦 My Orders" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Orders"
                            Visibility="{Binding IsSupplier, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Roles Section -->
                    <Border Margin="0,20,0,0" 
                            Padding="15,5" 
                            Background="#E3F2FD">
                        <TextBlock Text="Roles" 
                                  Foreground="#1976D2" 
                                  FontWeight="Bold" 
                                  FontSize="12"/>
                    </Border>

                    <Button Content="👨‍💼 Supervisor Dashboard" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="Supervisor"
                            Visibility="{Binding IsSupervisor, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="🤝 Supplier Portal" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="SupplierPortal"
                            Visibility="{Binding IsSupplier, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Logout Button -->
                    <Button Content="🚪 Logout" 
                            Style="{StaticResource NavButtonStyle}" 
                            Command="{Binding LogoutCommand}"
                            Margin="0,20,0,0"
                            Background="#FFEBEE"
                            Foreground="#C62828"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar - Only show when logged in -->
            <Border Grid.Row="0" 
                    Background="White" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="0,0,0,1" 
                    Height="60" 
                    Padding="20"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                              Text="{Binding WelcomeMessage}" 
                              VerticalAlignment="Center" 
                              FontSize="14" 
                              Foreground="#666666"/>

                    <!-- Notifications Button with Badge -->
                    <Button x:Name="NotificationsButton"
                            Grid.Column="1" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Margin="10,0" 
                            Width="40" 
                            Height="40"
                            Command="{Binding ToggleNotificationsCommand}">
                        <Grid>
                            <TextBlock Text="🔔" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <!-- Unread Notification Badge -->
                            <Border Background="#FF4444" 
                                    BorderBrush="White" 
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadNotificationCount}" 
                                          Foreground="White" 
                                          FontSize="9"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- User Profile Button -->
                    <Button x:Name="UserProfileButton"
                            Grid.Column="2" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Margin="10,0" 
                            Width="40" 
                            Height="40"
                            Command="{Binding ToggleUserProfileCommand}">
                        <Grid>
                            <Ellipse Fill="#1976D2" Width="32" Height="32"/>
                            <TextBlock Text="👤" 
                                      FontSize="14" 
                                      Foreground="White"
                                      VerticalAlignment="Center" 
                                      HorizontalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="3" 
                              Text="{Binding UserRoleDisplay}" 
                              VerticalAlignment="Center" 
                              FontSize="14" 
                              Foreground="#666666" 
                              Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Notifications Dropdown Popup -->
            <Popup x:Name="NotificationsPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=NotificationsButton}"
                   StaysOpen="False"
                   IsOpen="{Binding IsNotificationsOpen}"
                   Width="400"
                   MaxHeight="500">
                <Border Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1"
                        CornerRadius="4"
                        Effect="{StaticResource DropShadowEffect}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Notifications Header -->
                        <Border Grid.Row="0" 
                                Background="#1976D2" 
                                Padding="15,10"
                                CornerRadius="4,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Notifications" 
                                          Foreground="White" 
                                          FontWeight="Bold"
                                          VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Mark All Read"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="8,4"
                                        FontSize="11"
                                        Command="{Binding MarkAllNotificationsReadCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Notifications List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="350">
                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsRead, Converter={StaticResource ReadNotificationToBackgroundConverter}}"
                                                Padding="12,8"
                                                BorderBrush="#F0F0F0"
                                                BorderThickness="0,0,0,1"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                             Command="{Binding DataContext.NotificationClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Priority Indicator -->
                                                <Border Grid.Column="0" 
                                                        Width="3" 
                                                        Margin="0,2,8,2"
                                                        Background="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"
                                                        CornerRadius="1.5"/>

                                                <!-- Notification Content -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" 
                                                              FontWeight="SemiBold" 
                                                              Foreground="#333333"
                                                              TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Message}" 
                                                              FontSize="12" 
                                                              Foreground="#666666"
                                                              TextWrapping="Wrap"
                                                              Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource DateTimeToReadableConverter}}" 
                                                              FontSize="10" 
                                                              Foreground="#999999"
                                                              Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- Quick Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5,0,0,0">
                                                    <Button Content="✓" 
                                                            ToolTip="Mark as read"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4"
                                                            FontSize="10"
                                                            Command="{Binding DataContext.MarkAsReadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsRead, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <TextBlock Grid.Row="1"
                                  Text="No new notifications"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="#999999"
                                  FontStyle="Italic"
                                  Visibility="{Binding HasNotifications, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                        <!-- Notifications Footer -->
                        <Border Grid.Row="2" 
                                Background="#F5F5F5" 
                                Padding="10"
                                CornerRadius="0,0,4,4">
                            <Button Content="View All Notifications" 
                                    Background="Transparent"
                                    Foreground="#1976D2"
                                    BorderThickness="0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Command="{Binding ViewAllNotificationsCommand}"/>
                        </Border>
                    </Grid>
                </Border>
            </Popup>

            <!-- User Profile Dropdown Popup -->
            <Popup x:Name="UserProfilePopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=UserProfileButton}"
                   StaysOpen="False"
                   IsOpen="{Binding IsUserProfileOpen}"
                   Width="200">
                <Border Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1"
                        CornerRadius="4"
                        Effect="{StaticResource DropShadowEffect}">
                    <StackPanel>
                        <!-- User Info -->
                        <Border Background="#F8F9FA" Padding="15,12">
                            <StackPanel>
                                <TextBlock Text="{Binding UserProfileName}" 
                                          FontWeight="SemiBold" 
                                          Foreground="#333333"/>
                                <TextBlock Text="{Binding UserRoleDisplay}" 
                                          FontSize="11" 
                                          Foreground="#666666"
                                          Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Menu Items -->
                        <Button Content="👤 Edit Profile" 
                                Style="{StaticResource NavButtonStyle}"
                                Command="{Binding EditProfileCommand}"
                                BorderThickness="0"/>

                        <Button Content="🔧 Preferences" 
                                Style="{StaticResource NavButtonStyle}"
                                Command="{Binding PreferencesCommand}"
                                BorderThickness="0"/>

                        <Separator Background="#E0E0E0" Margin="0"/>

                        <Button Content="🚪 Logout" 
                                Style="{StaticResource NavButtonStyle}"
                                Command="{Binding LogoutCommand}"
                                Background="Transparent"
                                BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Content Area -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="0"/>
        </Grid>
    </Grid>
</Window>