<Window x:Class="MiningOps.Dialogs.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MiningOps.Converters"
        xmlns:models="clr-namespace:MiningOps.Models.Entities;assembly=MiningOps"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}" Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Add all required converters -->
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:ColorToSolidColorBrushConverter x:Key="ColorToSolidColorBrushConverter"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" 
                   Foreground="#333333" Margin="0,0,0,20"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Information -->
                <GroupBox Header="Basic Information" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Full Name*" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding User.FullName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Username*" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding User.Username, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Email*" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding User.Email, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Phone Number*" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding User.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Role & Security -->
                <GroupBox Header="Role &amp; Security" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Role*" FontWeight="SemiBold" Foreground="#333333"/>

                        <!-- Fixed Role ComboBox - Using ItemsSource with proper binding -->
                        <ComboBox ItemsSource="{Binding UserRoles}"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding User.Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,5,0,15" 
                                  Padding="10,8" 
                                  FontSize="14"/>

                        <!-- Password Change Section -->
                        <Border Background="#F8F9FA" Padding="10" CornerRadius="4" Margin="0,10,0,0">
                            <StackPanel>
                                <!-- For existing users: Password change option -->
                                <CheckBox Content="Change Password" 
                                          IsChecked="{Binding IsPasswordChangeRequested, Mode=TwoWay}"
                                          FontWeight="Bold" 
                                          Foreground="#1976D2"
                                          Margin="0,0,0,10"
                                          Visibility="{Binding IsNewUser, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                <!-- For new users: Always show password fields -->
                                <TextBlock Text="Password Setup" 
                                          FontWeight="Bold" 
                                          Foreground="#1976D2" 
                                          Margin="0,0,0,10"
                                          Visibility="{Binding IsNewUser, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Current Password (only for existing users changing password) -->
                                <TextBlock Text="Current Password" 
                                          FontWeight="SemiBold" 
                                          Foreground="#333333"
                                          Visibility="{Binding IsPasswordChangeRequested, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <PasswordBox x:Name="CurrentPasswordBox" 
                                            Visibility="{Binding IsPasswordChangeRequested, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            PasswordChanged="CurrentPasswordBox_PasswordChanged"
                                            ToolTip="Enter current password to change to a new one"/>

                                <!-- New Password (always shown for new users, shown for existing users when changing password) -->
                                <TextBlock Text="New Password" 
                                          FontWeight="SemiBold" 
                                          Foreground="#333333" 
                                          Margin="0,10,0,0"
                                          Visibility="{Binding IsNewUser, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="New Password" 
                                          FontWeight="SemiBold" 
                                          Foreground="#333333" 
                                          Margin="0,10,0,0"
                                          Visibility="{Binding IsPasswordChangeRequested, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <PasswordBox x:Name="NewPasswordBox" 
                                            PasswordChanged="NewPasswordBox_PasswordChanged"
                                            ToolTip="Enter new password (minimum 6 characters)"/>

                                <!-- Password Strength Indicator -->
                                <Border Background="{Binding PasswordStrengthColor, Converter={StaticResource ColorToSolidColorBrushConverter}}" 
                                        CornerRadius="3" 
                                        Height="4" 
                                        Margin="0,0,0,5"
                                        Visibility="{Binding ShowPasswordStrength, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="0" Color="{Binding PasswordStrengthColor}"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock Text="{Binding PasswordStrengthText}" 
                                          Foreground="{Binding PasswordStrengthColor, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                          FontSize="11" 
                                          Margin="0,0,0,10"
                                          Visibility="{Binding ShowPasswordStrength, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Confirm New Password -->
                                <TextBlock Text="Confirm New Password" FontWeight="SemiBold" Foreground="#333333"/>
                                <PasswordBox x:Name="ConfirmPasswordBox" 
                                            PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                            ToolTip="Re-enter the new password to confirm"/>

                                <!-- Password Match Indicator -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" 
                                           Visibility="{Binding ShowPasswordMatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="✓" 
                                              Foreground="Green" 
                                              FontWeight="Bold"
                                              Visibility="{Binding PasswordsMatch, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="✗" 
                                              Foreground="Red" 
                                              FontWeight="Bold"
                                              Visibility="{Binding PasswordsMatch, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding PasswordMatchText}" 
                                              Foreground="{Binding PasswordMatchColor, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                              FontSize="11" 
                                              Margin="5,0,0,0"/>
                                </StackPanel>

                                <!-- Password Requirements -->
                                <TextBlock Text="Password Requirements:" 
                                          FontSize="11" 
                                          FontWeight="SemiBold" 
                                          Foreground="#666" 
                                          Margin="0,10,0,5"/>
                                <StackPanel>
                                    <TextBlock Text="• Minimum 6 characters" 
                                              FontSize="10" 
                                              Foreground="#666"/>
                                    <TextBlock Text="• Include letters and numbers" 
                                              FontSize="10" 
                                              Foreground="#666"/>
                                    <TextBlock Text="• Avoid common passwords" 
                                              FontSize="10" 
                                              Foreground="#666"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Validation Errors -->
                <Border Background="#FFEBEE" 
                        BorderBrush="#FFCDD2" 
                        BorderThickness="1" 
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,10,0,0"
                        Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Please fix the following errors:" 
                                  FontWeight="Bold" 
                                  Foreground="#C62828"
                                  Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding ValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                              Foreground="#C62828" 
                                              FontSize="12"
                                              Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Background="#6C757D" Foreground="White" 
                    Command="{Binding CancelCommand}"/>
            <Button Content="Save" Background="#1976D2" Foreground="White" 
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"/>
        </StackPanel>
    </Grid>
</Window>