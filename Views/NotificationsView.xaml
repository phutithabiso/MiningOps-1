<UserControl x:Class="MiningOps.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MiningOps.Views"
             xmlns:converters="clr-namespace:MiningOps.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Define the converters locally if they're missing from MainWindow -->
        <converters:ReadStatusToTextConverter x:Key="ReadStatusToTextConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <Style x:Key="NotificationPriorityStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="High">
                    <Setter Property="Background" Value="#FFF44336"/>
                    <Setter Property="BorderBrush" Value="#FFD32F2F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Medium">
                    <Setter Property="Background" Value="#FFFF9800"/>
                    <Setter Property="BorderBrush" Value="#FFF57C00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Low">
                    <Setter Property="Background" Value="#FF4CAF50"/>
                    <Setter Property="BorderBrush" Value="#FF388E3C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Critical">
                    <Setter Property="Background" Value="#FFD32F2F"/>
                    <Setter Property="BorderBrush" Value="#FFB71C1C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadNotificationStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="#1976D2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1976D2" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="← Back" 
                        Background="Transparent" 
                        Foreground="White"
                        BorderThickness="0"
                        Padding="10,5"
                        Command="{Binding BackCommand}"
                        FontSize="12"/>

                <TextBlock Grid.Column="1" 
                          Text="Notifications" 
                          Foreground="White" 
                          FontSize="18" 
                          FontWeight="Bold"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" 
                            Background="Transparent" 
                            Foreground="White"
                            BorderThickness="1" 
                            BorderBrush="White"
                            Padding="10,5"
                            Command="{Binding RefreshCommand}"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics and Filters -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="15,10" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Statistics -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="White" Padding="10,5" Margin="0,0,10,0" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
                        <TextBlock Text="{Binding TotalNotifications, StringFormat='Total: {0}'}" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#E3F2FD" Padding="10,5" Margin="0,0,10,0" CornerRadius="4" BorderBrush="#BBDEFB" BorderThickness="1">
                        <TextBlock Text="{Binding UnreadCount, StringFormat='Unread: {0}'}" FontWeight="SemiBold" Foreground="#1976D2"/>
                    </Border>
                    <Border Background="#E8F5E8" Padding="10,5" Margin="0,0,10,0" CornerRadius="4" BorderBrush="#C8E6C9" BorderThickness="1">
                        <TextBlock Text="{Binding ReadCount, StringFormat='Read: {0}'}" FontWeight="SemiBold" Foreground="#2E7D32"/>
                    </Border>
                </StackPanel>

                <!-- Filters - Simplified for now -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Apply Filters" 
                            Background="#1976D2" 
                            Foreground="White"
                            Padding="10,5"
                            Command="{Binding FilterCommand}"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Notifications List -->
        <Grid Grid.Row="2">
            <!-- Show ItemsControl when there are notifications -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Padding="20">
                <ItemsControl ItemsSource="{Binding AllNotifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ReadNotificationStyle}"
                                    Padding="15" 
                                    Margin="0,0,0,10" 
                                    CornerRadius="4"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Priority Indicator -->
                                    <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                                           Width="4" 
                                           Margin="0,0,10,0"
                                           Style="{StaticResource NotificationPriorityStyle}"
                                           CornerRadius="2"/>

                                    <!-- Notification Content -->
                                    <StackPanel Grid.Column="1" Grid.Row="0">
                                        <TextBlock Text="{Binding Title}" 
                                                  FontWeight="SemiBold" 
                                                  FontSize="14"
                                                  Foreground="#333333"
                                                  TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Message}" 
                                                  FontSize="12" 
                                                  Foreground="#666666"
                                                  TextWrapping="Wrap"
                                                  Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Mark Read" 
                                                ToolTip="Mark as read"
                                                Background="Transparent" 
                                                BorderThickness="0"
                                                Padding="5"
                                                FontSize="10"
                                                Command="{Binding DataContext.MarkAsReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsRead, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                        <Button Content="Delete" 
                                                ToolTip="Delete"
                                                Background="Transparent" 
                                                BorderThickness="0"
                                                Padding="5"
                                                FontSize="10"
                                                Command="{Binding DataContext.DeleteNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>

                                    <!-- Metadata -->
                                    <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='MMM dd, yyyy hh:mm tt'}" 
                                                  FontSize="10" 
                                                  Foreground="#999999"/>
                                        <TextBlock Text="{Binding IsRead, Converter={StaticResource ReadStatusToTextConverter}}" 
                                                  FontSize="10" 
                                                  Foreground="#999999"
                                                  Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State - Show when no notifications -->
            <TextBlock Text="No notifications found" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Foreground="#999999"
                      FontStyle="Italic"
                      FontSize="14"
                      Visibility="{Binding HasNotifications, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="15,10" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Mark All as Read" 
                        Background="#4CAF50" 
                        Foreground="White"
                        Padding="15,8"
                        Command="{Binding MarkAllAsReadCommand}"
                        FontSize="12"
                        Margin="0,0,10,0"/>

                <Button Content="Clear All" 
                        Background="#F44336" 
                        Foreground="White"
                        Padding="15,8"
                        Command="{Binding ClearAllCommand}"
                        FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>