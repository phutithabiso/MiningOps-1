<Window x:Class="MiningOps.Views.UserProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MiningOps.Converters"
        mc:Ignorable="d"
        Title="User Profile" Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:ColorToSolidColorBrushConverter x:Key="ColorToSolidColorBrushConverter"/>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="User Profile" FontSize="20" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="Manage your account information and password" 
                      FontSize="12" Foreground="#666666" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- User Information -->
                <GroupBox Header="Personal Information" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Full Name" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding User.FullName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding User.Username, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding User.Email, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Phone Number" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding User.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Role" FontWeight="SemiBold" Foreground="#333333" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding User.Role}" FontSize="14" Foreground="#1976D2" FontWeight="SemiBold"/>
                    </StackPanel>
                </GroupBox>

                <!-- Password Change -->
                <GroupBox Header="Change Password" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Current Password" FontWeight="SemiBold" Foreground="#333333"/>
                        <PasswordBox x:Name="CurrentPasswordBox" 
                                    ToolTip="Enter your current password"/>

                        <TextBlock Text="New Password" FontWeight="SemiBold" Foreground="#333333"/>
                        <PasswordBox x:Name="NewPasswordBox" 
                                    ToolTip="Enter new password (minimum 6 characters)"/>

                        <TextBlock Text="Confirm New Password" FontWeight="SemiBold" Foreground="#333333"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" 
                                    ToolTip="Re-enter the new password to confirm"/>

                        <!-- Password Match Indicator -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,10" 
                                   Visibility="{Binding ShowPasswordMatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="✓" 
                                      Foreground="Green" 
                                      FontWeight="Bold"
                                      Visibility="{Binding PasswordsMatch, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="✗" 
                                      Foreground="Red" 
                                      FontWeight="Bold"
                                      Visibility="{Binding PasswordsMatch, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding PasswordMatchText}" 
                                      Foreground="{Binding PasswordMatchColor, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                      FontSize="11" 
                                      Margin="5,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Password Requirements:" 
                                  FontSize="11" 
                                  FontWeight="SemiBold" 
                                  Foreground="#666" 
                                  Margin="0,10,0,5"/>
                        <StackPanel>
                            <TextBlock Text="• Minimum 6 characters" 
                                      FontSize="10" 
                                      Foreground="#666"/>
                            <TextBlock Text="• Include letters and numbers" 
                                      FontSize="10" 
                                      Foreground="#666"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Validation Errors -->
                <Border Background="#FFEBEE" 
                        BorderBrush="#FFCDD2" 
                        BorderThickness="1" 
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,15,0,0"
                        Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Please fix the following errors:" 
                                  FontWeight="Bold" 
                                  Foreground="#C62828"
                                  Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding ValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                              Foreground="#C62828" 
                                              FontSize="12"
                                              Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Background="#6C757D" Foreground="White" 
                    Click="CancelButton_Click"/>
            <Button Content="Save Changes" Background="#1976D2" Foreground="White" 
                    Click="SaveButton_Click"
                    IsEnabled="{Binding CanSave}"/>
        </StackPanel>
    </Grid>
</Window>