<!-- InventoryDetailsDialog.xaml -->
<Window x:Class="MiningOps.Dialogs.InventoryDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Item Details" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Item Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Item ID:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InventoryId}" Margin="0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Item Name:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ItemName}" Margin="0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Description:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Description}" 
                               TextWrapping="Wrap" Margin="0,5" MaxHeight="60" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Quantity:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Quantity}" Margin="0,5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Unit Cost:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UnitCost, StringFormat='C2'}" Margin="0,5"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Reorder Level:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ReorderLevel}" Margin="0,5"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Warehouse:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Warehouse.Name}" Margin="0,5"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Last Updated:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LastUpdated, StringFormat='MM/dd/yyyy HH:mm'}" Margin="0,5"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Width="80" Height="30" 
                HorizontalAlignment="Center" Margin="0,20,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>