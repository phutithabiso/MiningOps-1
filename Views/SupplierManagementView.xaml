<UserControl x:Class="MiningOps.Views.SupplierManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MiningOps.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility"/>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrency"/>

        <!-- Dashboard Card Style -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8,0,8,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Value Style -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Metric Label Style -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Supplier Management" FontSize="24" FontWeight="Bold" 
                           Foreground="#333333" VerticalAlignment="Center"/>
                <Button Content="+ Add Supplier" Background="#1976D2" Foreground="White" 
                        Padding="15,8" BorderThickness="0" Margin="20,0,0,0"
                        FontSize="14" Cursor="Hand" Command="{Binding AddSupplierCommand}"/>
            </StackPanel>

            <!-- SUPPLIER DASHBOARD -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Quick Stats Row -->
                    <TextBlock Text="Supplier Overview" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#444444" Margin="0,0,0,12"/>

                    <WrapPanel Orientation="Horizontal">
                        <!-- Total Suppliers Card -->
                        <Border Style="{StaticResource DashboardCard}" Width="200">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#1976D2" Width="24" Height="24" CornerRadius="12">
                                        <TextBlock Text="🏭" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Total Suppliers" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Suppliers.Count}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="registered vendors" Style="{StaticResource MetricLabel}" 
                                           FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Active Suppliers -->
                        <Border Style="{StaticResource DashboardCard}" Width="220">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#4CAF50" Width="24" Height="24" CornerRadius="12">
                                        <TextBlock Text="✅" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Active Suppliers" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveSuppliersCount}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="currently active" Style="{StaticResource MetricLabel}" 
                                           FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Purchase Orders -->
                        <Border Style="{StaticResource DashboardCard}" Width="240">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#FF9800" Width="24" Height="24" CornerRadius="12">
                                        <TextBlock Text="📋" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Total Orders" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TotalPurchaseOrders}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="all-time orders" Style="{StaticResource MetricLabel}" 
                                           FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Pending Orders -->
                        <Border Style="{StaticResource DashboardCard}" Width="220">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#2196F3" Width="24" Height="24" CornerRadius="12">
                                        <TextBlock Text="⏳" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Pending Orders" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PendingOrdersCount}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="awaiting fulfillment" Style="{StaticResource MetricLabel}" 
                                           FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Quick Actions & Recent Suppliers -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <!-- Quick Actions -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Quick Actions" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#444444" Margin="0,0,0,8"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="📊 Supplier Report" Background="#2196F3" Foreground="White" 
                                            Padding="12,8" Margin="0,0,8,8" BorderThickness="0" FontSize="12"
                                            Command="{Binding ExportSupplierReportCommand}"/>
                                    <Button Content="🔄 Refresh Data" Background="#607D8B" Foreground="White" 
                                            Padding="12,8" Margin="0,0,8,8" BorderThickness="0" FontSize="12"
                                            Command="{Binding RefreshCommand}"/>
                                    <Button Content="📞 Contact List" Background="#4CAF50" Foreground="White" 
                                            Padding="12,8" Margin="0,0,8,8" BorderThickness="0" FontSize="12"
                                            Command="{Binding ExportContactListCommand}"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Search Box -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,16,0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="200" Padding="8" FontSize="12"
                                         materialDesign:HintAssist.Hint="Search suppliers...">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Content="🔍 Search" Command="{Binding SearchCommand}" 
                                        Background="#666666" Foreground="White" Margin="0,4,0,0"
                                        Padding="8,4" FontSize="11" BorderThickness="0"/>
                            </StackPanel>

                            <!-- Recent Suppliers -->
                            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Background="#E8F5E8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="👥 Recent Suppliers" FontSize="14" FontWeight="SemiBold" 
                                                       Foreground="#2E7D32"/>
                                            <Border Background="#4CAF50" CornerRadius="8" Padding="4,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding RecentSuppliers.Count}" FontSize="10" FontWeight="Bold" 
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding RecentSuppliers}" 
                                                      Visibility="{Binding RecentSuppliers.Count, Converter={StaticResource CountToVisibility}}"
                                                      MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F1F8E9" CornerRadius="4" Padding="8,6" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding CompanyName}" FontSize="11" 
                                                                       FontWeight="Medium" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ContactPerson}" 
                                                                       FontSize="10" Foreground="#666666" 
                                                                       FontStyle="Italic" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="No recent suppliers found" FontSize="12" Foreground="#666666" 
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                                   Visibility="{Binding RecentSuppliers.Count, Converter={StaticResource InverseCountToVisibility}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Performance Metrics -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,16,0,0" Background="#F3E5F5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="📈 Supplier Performance" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#7B1FA2" Margin="0,0,0,8"/>

                                <WrapPanel Orientation="Horizontal">
                                    <!-- Top Performing Supplier -->
                                    <Border Background="#E1BEE7" CornerRadius="6" Padding="12,8" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="🏆 Top Supplier" FontSize="11" FontWeight="Bold" 
                                                       Foreground="#7B1FA2" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding TopSupplier}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Average Response Time -->
                                    <Border Background="#E1BEE7" CornerRadius="6" Padding="12,8" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="⏱️ Avg Response" FontSize="11" FontWeight="Bold" 
                                                       Foreground="#7B1FA2" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding AverageResponseTime}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Order Completion Rate -->
                                    <Border Background="#E1BEE7" CornerRadius="6" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="📊 Completion Rate" FontSize="11" FontWeight="Bold" 
                                                       Foreground="#7B1FA2" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding OrderCompletionRate}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Search Bar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="300" Padding="10,5" FontSize="14" 
                         materialDesign:HintAssist.Hint="Search suppliers..."/>
                <Button Content="Search" Command="{Binding SearchCommand}" 
                        Margin="10,0,0,0" Padding="15,8" Background="#2196F3" 
                        Foreground="White" BorderThickness="0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" 
                        Margin="10,0,0,0" Padding="15,8" Background="#4CAF50" 
                        Foreground="White" BorderThickness="0"/>
            </StackPanel>

            <!-- Suppliers DataGrid -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid ItemsSource="{Binding Suppliers}" 
                          SelectedItem="{Binding SelectedSupplier}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True"
                          Background="White" BorderBrush="#E0E0E0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding SupplierId}" Width="60"/>
                        <DataGridTextColumn Header="Company Name" Binding="{Binding CompanyName}" Width="200"/>
                        <DataGridTextColumn Header="Contact Person" Binding="{Binding ContactPerson}" Width="150"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding RegisterMining.Email}" Width="200"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding RegisterMining.PhoneNumber}" Width="120"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="200"/>

                        <!-- Action Buttons -->
                        <DataGridTemplateColumn Header="Actions" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Background="#FFC107" Foreground="White" 
                                                Padding="8,4" Margin="2" BorderThickness="0" 
                                                FontSize="12" Cursor="Hand"
                                                Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Delete" Background="#DC3545" Foreground="White" 
                                                Padding="8,4" Margin="2" BorderThickness="0" 
                                                FontSize="12" Cursor="Hand"
                                                Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Grid>
    </ScrollViewer>
</UserControl>