<UserControl x:Class="MiningOps.Views.InventoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:MiningOps.Converters"
             mc:Ignorable="d" Height="723">

    <UserControl.Resources>
        <converters:QuantityToStatusConverter x:Key="QuantityToStatus"/>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrency"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility"/>
        <converters:WarehouseFilterConverter x:Key="WarehouseFilterConverter"/>
        <converters:QuantityToColorConverter x:Key="QuantityToColor"/>

        <!-- Dashboard Card Style -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8,0,8,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Value Style -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Metric Label Style -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Inventory Management" FontSize="24" FontWeight="Bold" 
                       Foreground="#333333" VerticalAlignment="Center"/>
            <Button Content="+ Add Item" Background="#1976D2" Foreground="White" 
                    Padding="15,8" BorderThickness="0" Margin="20,0,0,0"
                    FontSize="14" Cursor="Hand" Command="{Binding AddItemCommand}"/>
        </StackPanel>

        <!-- INVENTORY DASHBOARD -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <StackPanel>
                <!-- Quick Stats Row -->
                <TextBlock Text="Inventory Overview" FontSize="16" FontWeight="SemiBold" 
                           Foreground="#444444" Margin="0,0,0,12"/>

                <WrapPanel Orientation="Horizontal">
                    <!-- Total Items Card -->
                    <Border Style="{StaticResource DashboardCard}" Width="200">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#1976D2" Width="24" Height="24" CornerRadius="12">
                                    <TextBlock Text="📦" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Total Items" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding InventoryItems.Count}" Style="{StaticResource MetricValue}"/>
                            <TextBlock Text="across all warehouses" Style="{StaticResource MetricLabel}" 
                                       FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Inventory Value -->
                    <Border Style="{StaticResource DashboardCard}" Width="220">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#4CAF50" Width="24" Height="24" CornerRadius="12">
                                    <TextBlock Text="💰" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Total Value" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalInventoryValue, Converter={StaticResource DecimalToCurrency}}" 
                                       Style="{StaticResource MetricValue}"/>
                            <TextBlock Text="current stock valuation" Style="{StaticResource MetricLabel}" 
                                       FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Low Stock Alert -->
                    <Border Style="{StaticResource DashboardCard}" Width="220">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#FF9800" Width="24" Height="24" CornerRadius="12">
                                    <TextBlock Text="⚠️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Low Stock Items" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LowStockItems.Count}" Style="{StaticResource MetricValue}" 
                                       Foreground="#FF9800"/>
                            <TextBlock Text="need reordering" Style="{StaticResource MetricLabel}" 
                                       FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Out of Stock -->
                    <Border Style="{StaticResource DashboardCard}" Width="200">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#F44336" Width="24" Height="24" CornerRadius="12">
                                    <TextBlock Text="❌" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Out of Stock" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding OutOfStockCount}" Style="{StaticResource MetricValue}" 
                                       Foreground="#F44336"/>
                            <TextBlock Text="urgent restock needed" Style="{StaticResource MetricLabel}" 
                                       FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Quick Actions & Recent Low Stock -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Quick Actions -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Quick Actions" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="#444444" Margin="0,0,0,8"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="📊 Generate Stock Report" Background="#2196F3" Foreground="White" 
                                    Padding="12,8" Margin="0,0,8,8" BorderThickness="0" FontSize="12"
                                    Command="{Binding ExportLowStockCommand}"/>
                            <Button Content="🔄 Refresh Data" Background="#607D8B" Foreground="White" 
                                    Padding="12,8" Margin="0,0,8,8" BorderThickness="0" FontSize="12"
                                    Command="{Binding RefreshCommand}"/>
                            <Button Content="📋 Low Stock Report" Background="#FF9800" Foreground="White" 
                                    Padding="12,8" Margin="0,0,8,8" BorderThickness="0" FontSize="12"
                                    Command="{Binding ExportLowStockCommand}"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Search Box with Material Design Placeholder -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,16,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="200" Padding="8" FontSize="12"
                                 materialDesign:HintAssist.Hint="Search items...">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="🔍 Search" Command="{Binding SearchCommand}" 
                                Background="#666666" Foreground="White" Margin="0,4,0,0"
                                Padding="8,4" FontSize="11" BorderThickness="0"/>
                    </StackPanel>

                    <!-- Recent Low Stock Alerts -->
                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Background="#FFF3E0" Margin="6,-131,10,147">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🚨 Low Stock Alerts" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#E65100"/>
                                <Border Background="#FF9800" CornerRadius="8" Padding="4,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding LowStockItems.Count}" FontSize="10" FontWeight="Bold" 
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding LowStockItems}" 
                                          Visibility="{Binding LowStockItems.Count, Converter={StaticResource CountToVisibility}}"
                                          MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF8E1" CornerRadius="4" Padding="8,6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding ItemName}" FontSize="11" 
                                                           FontWeight="Medium" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity}" 
                                                           FontSize="11" Foreground="#F44336" 
                                                           FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="left" FontSize="10" 
                                                           Foreground="#666666" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="All items are well stocked! 🎉" FontSize="12" Foreground="#4CAF50" 
                                       HorizontalAlignment="Center" Margin="0,8,0,0"
                                       Visibility="{Binding LowStockItems.Count, Converter={StaticResource InverseCountToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Filters -->
                <Border Style="{StaticResource DashboardCard}" Margin="0,16,0,0" Background="#F5F5F5">
                    <StackPanel>
                        <TextBlock Text="Filters" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="#444444" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <!-- Warehouse Filter -->
                            <ComboBox ItemsSource="{Binding Warehouses}"
                                      DisplayMemberPath="Name"
                                      SelectedValue="{Binding WarehouseFilter, 
                                                              Converter={StaticResource WarehouseFilterConverter}, 
                                                              UpdateSourceTrigger=PropertyChanged}"
                                      Width="150"
                                      Margin="0,0,12,0"
                                      FontSize="12"
                                      Padding="8,4"/>

                            <!-- Stock Status Filter -->
                            <ComboBox SelectedItem="{Binding StockStatusFilter}"
                                      Width="120"
                                      Margin="0,0,12,0"
                                      FontSize="12"
                                      Padding="8,4">
                                <ComboBoxItem Content="All Status"/>
                                <ComboBoxItem Content="In Stock"/>
                                <ComboBoxItem Content="Low Stock"/>
                                <ComboBoxItem Content="Out of Stock"/>
                            </ComboBox>

                            <Button Content="Apply Filters" Command="{Binding SearchCommand}" 
                                    Background="#666666" Foreground="White" 
                                    Padding="12,6" FontSize="12" BorderThickness="0"/>
                            <Button Content="Clear Filters" Command="{Binding RefreshCommand}" 
                                    Background="Transparent" Foreground="#666666" 
                                    Padding="12,6" FontSize="12" BorderThickness="1" BorderBrush="#666666"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Inventory DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding InventoryItems}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                  Background="White" BorderBrush="#E0E0E0"
                  SelectedItem="{Binding SelectedItem}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding InventoryId}" Width="60"/>
                <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>

                <!-- Quantity Column with Color Converter -->
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Quantity, Converter={StaticResource QuantityToColor}}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat='C2'}" Width="100"/>
                <DataGridTextColumn Header="Reorder Level" Binding="{Binding ReorderLevel}" Width="100"/>
                <DataGridTextColumn Header="Warehouse" Binding="{Binding Warehouse.Name}" Width="120"/>
                <DataGridTextColumn Header="Last Updated" Binding="{Binding LastUpdated, StringFormat='MM/dd/yyyy'}" Width="100"/>

                <!-- Status Column with Simple Converter -->
                <DataGridTextColumn Header="Status" Width="100"
                                    Binding="{Binding Quantity, Converter={StaticResource QuantityToStatus}}"/>

                <!-- Action Buttons -->
                <DataGridTemplateColumn Header="Actions" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Background="#FFC107" Foreground="White" 
                                        Padding="8,4" Margin="2" BorderThickness="0" 
                                        FontSize="12" Cursor="Hand"
                                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Details" Background="#17A2B8" Foreground="White" 
                                        Padding="8,4" Margin="2" BorderThickness="0" 
                                        FontSize="12" Cursor="Hand"
                                        Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Delete" Background="#DC3545" Foreground="White" 
                                        Padding="8,4" Margin="2" BorderThickness="0" 
                                        FontSize="12" Cursor="Hand"
                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>