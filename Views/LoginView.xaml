<UserControl x:Class="MiningOps.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:MiningOps.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BooleanToLoginTextConverter x:Key="BooleanToLoginTextConverter"/>
    </UserControl.Resources>

    <Grid Background="#1976D2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Banner -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- 🔷 Banner Section -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20">
            <StackPanel>
                <TextBlock Text="YOU ARE VERY IMPORTANT. WE DRIVE TO MEET YOUR DEMAND ON TIME." 
                           Foreground="White" FontSize="18" FontWeight="Bold" 
                           TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="--------------------------------"
                           Foreground="White" FontSize="14" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 🔷 Main Section: Login (Left) + Our Services (Right) -->
        <Grid Grid.Row="1" Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ✅ Left: Sign In Section -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="40"
                    Margin="20"
                    Width="Auto"
                    VerticalAlignment="Center">
                <ScrollViewer>
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Margin="0,0,0,30" HorizontalAlignment="Center">
                            <TextBlock Text="🏢 MiningOps"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#1976D2"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Operations Management System"
                                       FontSize="14"
                                       Foreground="#666666"
                                       TextAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Login Form -->
                        <TextBlock Text="Sign In to Your Account"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <!-- Error Message -->
                        <Border Background="#FFEBEE"
                                BorderBrush="#FFCDD2"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,0,0,15"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#C62828"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#C62828"
                                        FontSize="12"
                                        Padding="5,2"
                                        Command="{Binding ClearErrorCommand}"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <!-- Username -->
                        <TextBlock Text="Username or Email" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12" FontSize="14" Margin="0,0,0,20"/>

                        <!-- Password -->
                        <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordBox" Padding="12" FontSize="14" Margin="0,0,0,30"/>

                        <!-- Login Button -->
                        <Border CornerRadius="4" Background="Transparent">
                            <Button Content="{Binding IsLoggingIn, Converter={StaticResource BooleanToLoginTextConverter}}"
                                    Command="{Binding LoginCommand}"
                                    Background="#1976D2"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Padding="15,12"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1565C0"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#BBDEFB"/>
                                                <Setter Property="Foreground" Value="#757575"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                        </Border>
                        <!-- Demo Credentials Hint -->
                        <Border Background="#E3F2FD"
        CornerRadius="4"
        Padding="15"
        Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Demo Credentials"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="#1976D2"
                   TextAlignment="Center"
                   Margin="0,0,0,5"/>
                                <TextBlock Text="Admin: admin / admin123"
                   FontSize="10"
                   Foreground="#1976D2"
                   TextAlignment="Center"/>
                                <TextBlock Text="Supplier: supplier1 / supplier123"
                   FontSize="10"
                   Foreground="#1976D2"
                   TextAlignment="Center"/>
                                <TextBlock Text="Supervisor: supervisor1 / supervisor123"
                   FontSize="10"
                   Foreground="#1976D2"
                   TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ✅ Right: Our Services Section -->
            <Border Grid.Column="1" Margin="20" Background="#1E88E5" CornerRadius="8" Padding="20" VerticalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Top">

                        <TextBlock Text="OUR SERVICES"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                        <TextBlock Text="MiningOps provides centralized digital platform for managing and tracking orders in mining operations services throughout the greater JHB area. From Mining supplies, Payments tracking, and warehouses inventory, our experienced workforce follows a proven methodology to get the job done on time and within budget."
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <UniformGrid Columns="3" Rows="1" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <!-- Service 1 -->
                    <Border Background="White" Margin="10" Padding="10" Width="150" CornerRadius="6">
                        <StackPanel>
                            <Image Source="pack://application:,,,/Assets/sportcourt.jpg" Height="70" Stretch="UniformToFill" Margin="0,0,0,10"/>
                            <TextBlock Text="WORKER GEAR" TextAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Service 2 -->
                    <Border Background="White" Margin="10" Padding="10" Width="150" CornerRadius="6">
                        <StackPanel>
                            <Image Source="pack://application:,,,/Assets/Electrical-Plans.jpg" Height="70" Stretch="UniformToFill" Margin="0,0,0,10"/>
                            <TextBlock Text="MUNICIPAL CONTRACTS" TextAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Service 3 -->
                    <Border Background="White" Margin="10" Padding="10" Width="150" CornerRadius="6">
                        <StackPanel>
                            <Image Source="pack://application:,,,/Assets/plumbing.jpg" Height="70" Stretch="UniformToFill" Margin="0,0,0,10"/>
                            <TextBlock Text="SCALE GEAR" TextAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                            <!-- Service 1 -->
                            <Border Background="White" Margin="10" Padding="10" Width="150" CornerRadius="6">
                                <StackPanel>
                                    <Image Source="pack://application:,,,/Assets/thread.png" Height="70" Stretch="UniformToFill" Margin="0,0,0,10"/>
                                    <TextBlock Text="THREADED BUTTON BITS" TextAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Service 2 -->
                            <Border Background="White" Margin="10" Padding="10" Width="150" CornerRadius="6">
                                <StackPanel>
                                    <Image Source="pack://application:,,,/Assets/barac.png" Height="70" Stretch="UniformToFill" Margin="0,0,0,10"/>
                                    <TextBlock Text="Mining Buckets" TextAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Service 3 -->
                            <Border Background="White" Margin="10" Padding="10" Width="150" CornerRadius="6">
                                <StackPanel>
                                    <Image Source="pack://application:,,,/Assets/ROCKBREAKER.jpg" Height="70" Stretch="UniformToFill" Margin="0,0,0,10"/>
                                    <TextBlock Text="ROCKBREAKERS" TextAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <!-- Service 1 -->
                            <Border Background="White" Margin="10" Padding="10" Width="150" CornerRadius="6">
                                <StackPanel>
                                    <Image Source="pack://application:,,,/Assets/WHEELBARR.jpg" Height="70" Stretch="UniformToFill" Margin="0,0,0,19"/>
                                    <TextBlock Text="Concrete Wheelbarrow" TextAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Service 2 -->
                            <Border Background="White" Margin="10" Padding="10" Width="150" CornerRadius="6">
                                <StackPanel>
                                    <Image Source="pack://application:,,,/Assets/ginder.png" Height="70" Stretch="UniformToFill" Margin="0,0,0,19"/>
                                    <TextBlock Text="Refurbishments" TextAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- Service 3 -->
                            <Border Background="White" Margin="10" Padding="10" Width="150" CornerRadius="6">
                                <StackPanel>
                                    <Image Source="pack://application:,,,/Assets/SHOVEL.jpg" Height="70" Stretch="UniformToFill" Margin="0,0,0,19"/>
                                    <TextBlock Text="Pit Pan Shovel" TextAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</UserControl>
