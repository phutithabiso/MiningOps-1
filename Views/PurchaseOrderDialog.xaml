<Window x:Class="MiningOps.Dialogs.PurchaseOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Order" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Purchase Order Details" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Information -->
                <Grid Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Supplier:" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" 
                              ItemsSource="{Binding Suppliers}"
                              DisplayMemberPath="CompanyName"
                              SelectedValue="{Binding SelectedSupplier}"
                              Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Material Request:" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" 
                              ItemsSource="{Binding MaterialRequests}"
                              DisplayMemberPath="ItemName"
                              SelectedValue="{Binding SelectedMaterialRequest}"
                              SelectionChanged="MaterialRequest_SelectionChanged"
                              Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Currency:" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" 
                              SelectedValue="{Binding Currency}"
                              Margin="0,0,0,10">
                        <ComboBoxItem Content="ZAR"/>
                        <ComboBoxItem Content="USD"/>
                        <ComboBoxItem Content="EUR"/>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Expected Delivery:" Style="{StaticResource FormLabel}"/>
                    <DatePicker Grid.Row="3" Grid.Column="1" 
                                SelectedDate="{Binding ExpectedDeliveryDate}"
                                Margin="0,0,0,10"/>
                </Grid>

                <TextBlock Text="Order Items" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>

                <!-- Order Items DataGrid -->
                <DataGrid x:Name="ItemsDataGrid" 
                          ItemsSource="{Binding OrderItems}" 
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="True"
                          Background="White" 
                          BorderBrush="#E0E0E0"
                          Height="250">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item Name" 
                                          Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" 
                                          Width="*"/>
                        <DataGridTextColumn Header="Quantity" 
                                          Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                          Width="80"/>
                        <DataGridTextColumn Header="Unit Price" 
                                          Binding="{Binding UnitPrice, StringFormat='C2', UpdateSourceTrigger=PropertyChanged}" 
                                          Width="100"/>
                        <DataGridTextColumn Header="Total" 
                                          Binding="{Binding TotalPrice, StringFormat='C2', Mode=OneWay}" 
                                          Width="100" 
                                          IsReadOnly="True"/>
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove" 
                                            Click="RemoveItem_Click"
                                            Background="#D32F2F" 
                                            Foreground="White" 
                                            Padding="8,2"
                                            FontSize="10"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add Item Controls -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add New Item" 
                            Click="AddItem_Click" 
                            Background="#1976D2" 
                            Foreground="White" 
                            Padding="15,5"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Total Amount -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding TotalAmount, StringFormat='Total Amount: {0:C2}'}" 
                   FontSize="14" 
                   FontWeight="Bold" 
                   Margin="0,10,0,10"
                   HorizontalAlignment="Right"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" 
                    Width="80" 
                    Height="30" 
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button Content="Save" 
                    Width="80" 
                    Height="30" 
                    Background="#1976D2" 
                    Foreground="White"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>