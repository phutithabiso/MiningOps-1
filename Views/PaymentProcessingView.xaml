<UserControl x:Class="MiningOps.Views.PaymentProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:MiningOps.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusColorConverter"/>
        <converters:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>

        <Style x:Key="PaymentMetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="PaymentMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PaymentMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Payment Dashboard -->
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Loading Indicator -->
                <RowDefinition Height="Auto"/>
                <!-- Financial Summary -->
                <RowDefinition Height="Auto"/>
                <!-- Search and Filter -->
                <RowDefinition Height="*"/>
                <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- PAYMENT PROCESSING DASHBOARD -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <Border Background="#F8F9FA" CornerRadius="6" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Payment Processing Dashboard" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#333333" Margin="0,0,0,10"/>

                        <!-- Payment Metrics Row -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <UniformGrid Columns="5">
                                <!-- Total Payments -->
                                <Border Style="{StaticResource PaymentMetricCardStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Cash" Width="20" Height="20" 
                                                               Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource PaymentMetricValueStyle}" 
                                                   Text="{Binding Payments.Count}"/>
                                        <TextBlock Style="{StaticResource PaymentMetricLabelStyle}" Text="Total Payments"/>
                                    </StackPanel>
                                </Border>

                                <!-- Outstanding Amount -->
                                <Border Style="{StaticResource PaymentMetricCardStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="AlertCircle" Width="20" Height="20" 
                                                               Foreground="#FF9800" HorizontalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource PaymentMetricValueStyle}" 
                                                   Text="{Binding TotalOutstanding, StringFormat='C'}"/>
                                        <TextBlock Style="{StaticResource PaymentMetricLabelStyle}" Text="Outstanding"/>
                                    </StackPanel>
                                </Border>

                                <!-- Paid This Month -->
                                <Border Style="{StaticResource PaymentMetricCardStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="CashCheck" Width="20" Height="20" 
                                                               Foreground="#2196F3" HorizontalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource PaymentMetricValueStyle}" 
                                                   Text="{Binding TotalPaidThisMonth, StringFormat='C'}"/>
                                        <TextBlock Style="{StaticResource PaymentMetricLabelStyle}" Text="Paid This Month"/>
                                    </StackPanel>
                                </Border>

                                <!-- Overdue Invoices -->
                                <Border Style="{StaticResource PaymentMetricCardStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="ClockAlert" Width="20" Height="20" 
                                                               Foreground="#F44336" HorizontalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource PaymentMetricValueStyle}" 
                                                   Text="{Binding OverdueInvoicesCount}"/>
                                        <TextBlock Style="{StaticResource PaymentMetricLabelStyle}" Text="Overdue Invoices"/>
                                    </StackPanel>
                                </Border>

                                <!-- Unpaid Invoices -->
                                <Border Style="{StaticResource PaymentMetricCardStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="FileDocument" Width="20" Height="20" 
                                                               Foreground="#9C27B0" HorizontalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource PaymentMetricValueStyle}" 
                                                   Text="{Binding UnpaidInvoicesCount}"/>
                                        <TextBlock Style="{StaticResource PaymentMetricLabelStyle}" Text="Unpaid Invoices"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </ScrollViewer>

                        <!-- Quick Stats Row -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Recent Payments -->
                                <Border Grid.Column="0" Style="{StaticResource PaymentMetricCardStyle}" Margin="5,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                        <StackPanel>
                                            <TextBlock Text="Recent Payments" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="#333333" Margin="0,0,0,5"/>
                                            <ItemsControl ItemsSource="{Binding RecentPayments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding SafePaymentReference}" 
                                                                               FontSize="11" FontWeight="SemiBold" 
                                                                               Foreground="#333333" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding PaidDate, StringFormat='MMM dd'}" 
                                                                               FontSize="10" Foreground="#666666"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding SafeAmount, StringFormat='C'}" 
                                                                               FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50"/>
                                                                    <TextBlock Text="{Binding Invoice.SafeInvoiceReference}" 
                                                                               FontSize="9" Foreground="#666666" TextAlignment="Right"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="No recent payments" FontStyle="Italic" Foreground="#999999" 
                                                       FontSize="11" HorizontalAlignment="Center" Margin="0,5"
                                                       Visibility="{Binding RecentPayments.Count, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <!-- Pending Approval -->
                                <Border Grid.Column="1" Style="{StaticResource PaymentMetricCardStyle}" Margin="5,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                        <StackPanel>
                                            <TextBlock Text="Pending Approval" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="#333333" Margin="0,0,0,5"/>
                                            <ItemsControl ItemsSource="{Binding PendingApprovalPayments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="0,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding SafePaymentReference}" 
                                                                               FontSize="11" FontWeight="SemiBold" 
                                                                               Foreground="#333333" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Invoice.SafeInvoiceReference}" 
                                                                               FontSize="10" Foreground="#666666"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding SafeAmount, StringFormat='C'}" 
                                                                               FontSize="11" FontWeight="SemiBold" Foreground="#FF9800"/>
                                                                    <Button Content="Approve" Background="#28A745" Foreground="White" 
                                                                            Padding="4,2" Margin="0,2,0,0" FontSize="9" Cursor="Hand"
                                                                            Command="{Binding DataContext.ApprovePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            materialDesign:ButtonAssist.CornerRadius="2"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="No payments pending approval" FontStyle="Italic" Foreground="#999999" 
                                                       FontSize="11" HorizontalAlignment="Center" Margin="0,5"
                                                       Visibility="{Binding PendingApprovalPayments.Count, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- HEADER -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Payment Processing" FontSize="24" FontWeight="Bold" 
                           Foreground="#333333" VerticalAlignment="Center"/>
                <Button Content="+ Process Payment" Background="#1976D2" Foreground="White" 
                        Padding="15,8" BorderThickness="0" Margin="20,0,0,0"
                        FontSize="14" Cursor="Hand" Command="{Binding ProcessPaymentCommand}"
                        materialDesign:ButtonAssist.CornerRadius="2"/>
            </StackPanel>

            <!-- LOADING INDICATOR -->
            <Border Grid.Row="2" Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1" 
                    CornerRadius="5" Padding="10" Margin="0,0,0,15"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Loading payment data..." VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- FINANCIAL SUMMARY (Simplified) -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,15">
                <Border Background="#E7F3FF" BorderBrush="#B8D4F0" BorderThickness="1" 
                        CornerRadius="5" Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Quick Stats: " FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Outstanding: " Foreground="#666666" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalOutstanding, StringFormat='C'}" FontWeight="SemiBold" Foreground="#DC3545" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Monthly Payments: " Foreground="#666666" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPaidThisMonth, StringFormat='C'}" FontWeight="SemiBold" Foreground="#28A745" Margin="0,0,15,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Overdue: " Foreground="#666666" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OverdueInvoicesCount}" FontWeight="SemiBold" Foreground="#FFC107" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- SEARCH AND FILTER -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="200" Padding="8" Margin="0,0,10,0"
                         materialDesign:HintAssist.Hint="Search payments..."/>
                <ComboBox SelectedValue="{Binding StatusFilter}" Width="120" Margin="0,0,10,0"
                          materialDesign:HintAssist.Hint="Status">
                    <ComboBoxItem Content="All Status"/>
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Approved"/>
                    <ComboBoxItem Content="Paid"/>
                    <ComboBoxItem Content="Overdue"/>
                </ComboBox>
                <Button Content="Search" Command="{Binding SearchCommand}" 
                        Padding="10,5" Margin="0,0,10,0"
                        materialDesign:ButtonAssist.CornerRadius="2"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" 
                        Padding="10,5" Margin="0,0,10,0" Background="#6C757D" Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="2"/>
                <Button Content="Export" Command="{Binding ExportPaymentsCommand}" 
                        Padding="10,5" Background="#28A745" Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="2"/>
            </StackPanel>

            <!-- PAYMENTS DATAGRID -->
            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                          Background="White" BorderBrush="#E0E0E0"
                          SelectedItem="{Binding SelectedPayment}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Payment ID" Binding="{Binding PaymentId}" Width="80"/>
                        <DataGridTextColumn Header="Invoice Ref" Binding="{Binding Invoice.SafeInvoiceReference}" Width="120"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding SafeAmount, StringFormat='C'}" Width="100"/>
                        <DataGridTextColumn Header="Paid Date" Binding="{Binding PaidDate, StringFormat='MM/dd/yyyy'}" Width="100"/>
                        <DataGridTextColumn Header="Payment Ref" Binding="{Binding SafePaymentReference}" Width="150"/>
                        <DataGridTextColumn Header="Approved By" Binding="{Binding ApprovedBy.FullName}" Width="120"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding Invoice.Order.Supplier.CompanyName}" Width="150"/>

                        <!-- Action Buttons -->
                        <DataGridTemplateColumn Header="Actions" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Details" Background="#17A2B8" Foreground="White" 
                                                Padding="6,3" Margin="2" BorderThickness="0" 
                                                FontSize="11" Cursor="Hand"
                                                Command="{Binding DataContext.ViewPaymentDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                materialDesign:ButtonAssist.CornerRadius="2"/>
                                        <Button Content="Approve" Background="#28A745" Foreground="White" 
                                                Padding="6,3" Margin="2" BorderThickness="0" 
                                                FontSize="11" Cursor="Hand"
                                                Command="{Binding DataContext.ApprovePaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                materialDesign:ButtonAssist.CornerRadius="2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Grid>
    </ScrollViewer>
</UserControl>