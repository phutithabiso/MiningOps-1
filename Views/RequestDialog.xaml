<Window x:Class="MiningOps.Dialogs.RequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MiningOps.Converters"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}" Height="350" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" 
                   Foreground="#333333" Margin="0,0,0,20"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <!-- Item Information -->
            <GroupBox Header="Request Information" Padding="10">
                <StackPanel>
                    <TextBlock Text="Item Name*" FontWeight="SemiBold" Foreground="#333333"/>
                    <TextBox Text="{Binding Request.ItemName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Quantity*" FontWeight="SemiBold" Foreground="#333333"/>
                    <TextBox Text="{Binding Request.Quantity, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Status (read-only for new requests, editable for existing) -->
                    <TextBlock Text="Status" FontWeight="SemiBold" Foreground="#333333" Margin="0,10,0,5"/>
                    <TextBlock Text="{Binding Request.Status}" FontSize="14" 
                               Padding="10,8" Background="#F5F5F5" 
                               Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Background="#6C757D" Foreground="White" 
                    Click="CancelButton_Click"/>
            <Button Content="Save" Background="#1976D2" Foreground="White" 
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>