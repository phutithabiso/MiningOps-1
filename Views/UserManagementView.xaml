<UserControl x:Class="MiningOps.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MiningOps.Converters">

    <UserControl.Resources>
        <converters:NullToStatusConverter x:Key="NullToStatusConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- USER DASHBOARD SECTION -->
        <Border Grid.Row="0" Background="#F5F7F9" BorderBrush="#E1E5E9" BorderThickness="1" 
                CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Total Users Card -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E1E5E9" BorderThickness="1" 
                        CornerRadius="6" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="TOTAL USERS" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="#6C757D" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding TotalUsersCount}" FontSize="28" FontWeight="Bold" 
                                   Foreground="#1976D2"/>
                        <TextBlock Text="All Registered Users" FontSize="11" Foreground="#6C757D"/>
                    </StackPanel>
                </Border>

                <!-- Admin Users Card -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E1E5E9" BorderThickness="1" 
                        CornerRadius="6" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="ADMINISTRATORS" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="#6C757D" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding AdminUsersCount}" FontSize="28" FontWeight="Bold" 
                                   Foreground="#DC3545"/>
                        <TextBlock Text="System Administrators" FontSize="11" Foreground="#6C757D"/>
                    </StackPanel>
                </Border>

                <!-- Supervisor Users Card -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E1E5E9" BorderThickness="1" 
                        CornerRadius="6" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="SUPERVISORS" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="#6C757D" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SupervisorUsersCount}" FontSize="28" FontWeight="Bold" 
                                   Foreground="#FF9800"/>
                        <TextBlock Text="Operation Supervisors" FontSize="11" Foreground="#6C757D"/>
                    </StackPanel>
                </Border>

                <!-- Supplier Users Card -->
                <Border Grid.Column="3" Background="White" BorderBrush="#E1E5E9" BorderThickness="1" 
                        CornerRadius="6" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="SUPPLIERS" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="#6C757D" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding SupplierUsersCount}" FontSize="28" FontWeight="Bold" 
                                   Foreground="#28A745"/>
                        <TextBlock Text="Vendor Suppliers" FontSize="11" Foreground="#6C757D"/>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <StackPanel Grid.Column="4" Orientation="Vertical" Margin="20,0,0,0" 
                            VerticalAlignment="Center">
                    <Button Content="+ Add New User" Background="#1976D2" Foreground="White" 
                            Padding="15,10" BorderThickness="0" FontSize="14" FontWeight="SemiBold"
                            Cursor="Hand" Command="{Binding AddUserCommand}" Margin="0,0,0,10"/>
                    <Button Content="🔄 Refresh Data" Background="#6C757D" Foreground="White" 
                            Padding="12,8" BorderThickness="0" FontSize="12"
                            Cursor="Hand" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header Section -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="User Management" FontSize="24" FontWeight="Bold" 
                       Foreground="#333333" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Users.Count, StringFormat='{} ({0} users)'}" 
                       FontSize="16" Foreground="#6C757D" VerticalAlignment="Center" 
                       Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Users DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" 
                  SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True"
                  Background="White" BorderBrush="#E0E0E0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding AccId}" Width="60"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="150"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="120"/>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat='MM/dd/yyyy'}" Width="100"/>

                <!-- Action Buttons -->
                <DataGridTemplateColumn Header="Actions" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Background="#FFC107" Foreground="White" 
                                        Padding="8,4" Margin="2" BorderThickness="0" 
                                        FontSize="12" Cursor="Hand"
                                        Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                       <Button Content="Details" Background="#17A2B8" Foreground="White" 
                                         Padding="8,4" Margin="2" BorderThickness="0" 
                                         FontSize="12" Cursor="Hand"
                                         Command="{Binding DataContext.ShowUserDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                         CommandParameter="{Binding}"/>
                                       <Button Content="Delete" Background="#DC3545" Foreground="White" 
                                        Padding="8,4" Margin="2" BorderThickness="0" 
                                        FontSize="12" Cursor="Hand"
                                        Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>