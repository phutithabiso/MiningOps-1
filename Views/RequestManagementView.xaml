<UserControl x:Class="MiningOps.Views.RequestManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MiningOps.Converters"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <converters:InverseCountToVisibilityConverter x:Key="InverseCountToVisibility"/>
        <converters:DateTimeToReadableConverter x:Key="DateTimeToReadable"/>

        <!-- Dashboard Card Style -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8,0,8,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Value Style -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Metric Label Style -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Material Request Management" FontSize="24" FontWeight="Bold" 
                           Foreground="#333333" VerticalAlignment="Center"/>
                <Button Content="+ New Request" Background="#1976D2" Foreground="White" 
                        Padding="15,8" BorderThickness="0" Margin="20,0,0,0"
                        FontSize="14" Cursor="Hand" Command="{Binding AddRequestCommand}"/>
            </StackPanel>

            <!-- REQUEST DASHBOARD -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Quick Stats Row -->
                    <TextBlock Text="Request Overview" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#444444" Margin="0,0,0,12"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <WrapPanel Orientation="Horizontal">
                            <!-- Total Requests Card -->
                            <Border Style="{StaticResource DashboardCard}" Width="200">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#1976D2" Width="24" Height="24" CornerRadius="12">
                                            <TextBlock Text="📋" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Total Requests" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Requests.Count}" Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="all material requests" Style="{StaticResource MetricLabel}" 
                                               FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Pending Requests -->
                            <Border Style="{StaticResource DashboardCard}" Width="220">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#FF9800" Width="24" Height="24" CornerRadius="12">
                                            <TextBlock Text="⏳" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Pending Approval" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PendingRequestsCount}" Style="{StaticResource MetricValue}" 
                                               Foreground="#FF9800"/>
                                    <TextBlock Text="awaiting review" Style="{StaticResource MetricLabel}" 
                                               FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Approved Requests -->
                            <Border Style="{StaticResource DashboardCard}" Width="200">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#4CAF50" Width="24" Height="24" CornerRadius="12">
                                            <TextBlock Text="✅" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Approved" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ApprovedRequestsCount}" Style="{StaticResource MetricValue}" 
                                               Foreground="#4CAF50"/>
                                    <TextBlock Text="ready for ordering" Style="{StaticResource MetricLabel}" 
                                               FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Rejected Requests -->
                            <Border Style="{StaticResource DashboardCard}" Width="200">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#F44336" Width="24" Height="24" CornerRadius="12">
                                            <TextBlock Text="❌" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Rejected" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RejectedRequestsCount}" Style="{StaticResource MetricValue}" 
                                               Foreground="#F44336"/>
                                    <TextBlock Text="not approved" Style="{StaticResource MetricLabel}" 
                                               FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Approval Rate -->
                            <Border Style="{StaticResource DashboardCard}" Width="180">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#9C27B0" Width="24" Height="24" CornerRadius="12">
                                            <TextBlock Text="📊" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Approval Rate" Style="{StaticResource MetricLabel}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ApprovalRate}" Style="{StaticResource MetricValue}" 
                                               Foreground="#9C27B0"/>
                                    <TextBlock Text="success rate" Style="{StaticResource MetricLabel}" 
                                               FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </ScrollViewer>

                    <!-- Quick Actions & Recent Requests -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="350"/>
                            </Grid.ColumnDefinitions>

                            <!-- Quick Actions -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Quick Actions" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#444444" Margin="0,0,0,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="📊 Request Report" Background="#2196F3" Foreground="White" 
                                                Padding="12,8" Margin="0,0,8,8" BorderThickness="0" FontSize="12"
                                                Command="{Binding ExportRequestsReportCommand}"/>
                                        <Button Content="🔄 Refresh Data" Background="#607D8B" Foreground="White" 
                                                Padding="12,8" Margin="0,0,8,8" BorderThickness="0" FontSize="12"
                                                Command="{Binding RefreshCommand}"/>
                                        <Button Content="✅ Bulk Approve" Background="#4CAF50" Foreground="White" 
                                                Padding="12,8" Margin="0,0,8,8" BorderThickness="0" FontSize="12"
                                                Command="{Binding BulkApproveCommand}"/>
                                        <Button Content="📋 Pending Report" Background="#FF9800" Foreground="White" 
                                                Padding="12,8" Margin="0,0,8,8" BorderThickness="0" FontSize="12"
                                                Command="{Binding ExportPendingReportCommand}"/>
                                    </WrapPanel>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Search Box -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,16,0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="200" Padding="8" FontSize="12"
                                         materialDesign:HintAssist.Hint="Search requests...">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding FilterCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Content="🔍 Search" Command="{Binding FilterCommand}" 
                                        Background="#666666" Foreground="White" Margin="0,4,0,0"
                                        Padding="8,4" FontSize="11" BorderThickness="0"/>
                            </StackPanel>

                            <!-- Urgent Pending Requests -->
                            <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Background="#FFF3E0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="🚨 Urgent Requests" FontSize="14" FontWeight="SemiBold" 
                                                       Foreground="#E65100"/>
                                            <Border Background="#FF9800" CornerRadius="8" Padding="4,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding UrgentRequests.Count}" FontSize="10" FontWeight="Bold" 
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding UrgentRequests}" 
                                                      Visibility="{Binding UrgentRequests.Count, Converter={StaticResource CountToVisibility}}"
                                                      MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFF8E1" CornerRadius="4" Padding="8,6" Margin="0,2"
                                                            BorderBrush="#FF9800" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding ItemName}" FontSize="11" 
                                                                       FontWeight="Medium" VerticalAlignment="Center"
                                                                       ToolTip="{Binding ItemName}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" 
                                                                       FontSize="11" Foreground="#F44336" 
                                                                       FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="needed" FontSize="10" 
                                                                       Foreground="#666666" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="No urgent requests pending" FontSize="12" Foreground="#4CAF50" 
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                                   Visibility="{Binding UrgentRequests.Count, Converter={StaticResource InverseCountToVisibility}}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Request Statistics -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,16,0,0" Background="#E3F2FD">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="📈 Request Statistics" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#1565C0" Margin="0,0,0,8"/>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <WrapPanel Orientation="Horizontal">
                                        <!-- Average Processing Time -->
                                        <Border Background="#BBDEFB" CornerRadius="6" Padding="12,8" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="⏱️ Avg Processing" FontSize="11" FontWeight="Bold" 
                                                           Foreground="#1565C0" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding AverageProcessingTime}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Most Requested Item -->
                                        <Border Background="#BBDEFB" CornerRadius="6" Padding="12,8" Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="🔥 Top Item" FontSize="11" FontWeight="Bold" 
                                                           Foreground="#1565C0" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding MostRequestedItem}" FontSize="12" FontWeight="SemiBold"
                                                           MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- This Week's Requests -->
                                        <Border Background="#BBDEFB" CornerRadius="6" Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="📅 This Week" FontSize="11" FontWeight="Bold" 
                                                           Foreground="#1565C0" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding ThisWeekRequests}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Search and Filter Bar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="250" Padding="10,5" FontSize="14" 
                         materialDesign:HintAssist.Hint="Search requests..."/>

                <ComboBox SelectedValue="{Binding StatusFilter}" Width="150" Margin="10,0,0,0">
                    <ComboBoxItem Content="All Statuses" IsSelected="True"/>
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Approved"/>
                    <ComboBoxItem Content="Rejected"/>
                </ComboBox>

                <Button Content="Search" Command="{Binding FilterCommand}" 
                        Margin="10,0,0,0" Padding="15,8" Background="#2196F3" 
                        Foreground="White" BorderThickness="0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" 
                        Margin="10,0,0,0" Padding="15,8" Background="#4CAF50" 
                        Foreground="White" BorderThickness="0"/>
            </StackPanel>

            <!-- Requests DataGrid -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <DataGrid ItemsSource="{Binding Requests}" 
                          SelectedItem="{Binding SelectedRequest}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True"
                          Background="White" BorderBrush="#E0E0E0">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding MaterialRequestId}" Width="60"/>
                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="200"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5,2"/>
                                    <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Request Date" Binding="{Binding RequestDate, StringFormat='MM/dd/yyyy'}" Width="120"/>
                        <DataGridTextColumn Header="Time Since" Binding="{Binding RequestDate, Converter={StaticResource DateTimeToReadable}}" Width="100"/>

                        <!-- Action Buttons -->
                        <DataGridTemplateColumn Header="Actions" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Background="#FFC107" Foreground="White" 
                                                Padding="8,4" Margin="2" BorderThickness="0" 
                                                FontSize="12" Cursor="Hand"
                                                Command="{Binding DataContext.EditRequestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Approve" Background="#28A745" Foreground="White" 
                                                Padding="8,4" Margin="2" BorderThickness="0" 
                                                FontSize="12" Cursor="Hand"
                                                Command="{Binding DataContext.ApproveRequestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Reject" Background="#DC3545" Foreground="White" 
                                                Padding="8,4" Margin="2" BorderThickness="0" 
                                                FontSize="12" Cursor="Hand"
                                                Command="{Binding DataContext.RejectRequestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Delete" Background="#6C757D" Foreground="White" 
                                                Padding="8,4" Margin="2" BorderThickness="0" 
                                                FontSize="12" Cursor="Hand"
                                                Command="{Binding DataContext.DeleteRequestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Grid>
    </ScrollViewer>
</UserControl>