<Window x:Class="MiningOps.Dialogs.InventoryItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}" Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" 
                   Foreground="#333333" Margin="0,0,0,20"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Information -->
                <GroupBox Header="Basic Information" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Item Name*" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding InventoryItem.ItemName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Description" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding InventoryItem.Description, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                        <TextBlock Text="Unit" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding InventoryItem.Unit, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Stock Information -->
                <GroupBox Header="Stock Information" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Current Quantity*" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding InventoryItem.Quantity, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Reorder Level*" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding InventoryItem.ReorderLevel, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Unit Cost*" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding InventoryItem.UnitCost, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Location Information -->
                <GroupBox Header="Location Information" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Warehouse*" FontWeight="SemiBold" Foreground="#333333"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" 
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="WarehouseId"
                                  SelectedValue="{Binding InventoryItem.WarehouseId}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Additional Information -->
                <GroupBox Header="Additional Information" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Category" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding InventoryItem.Category, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Supplier SKU" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding InventoryItem.SupplierSKU, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Notes" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding InventoryItem.Notes, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Background="#6C757D" Foreground="White" 
                    Click="CancelButton_Click"/>
            <Button Content="Save" Background="#1976D2" Foreground="White" 
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>