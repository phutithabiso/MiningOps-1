<Window x:Class="MiningOps.Dialogs.PaymentDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment Details" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Payment Details" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Payment ID:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PaymentId}" Margin="0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Invoice Reference:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Invoice.InvoiceReference}" Margin="0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Amount:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Amount, StringFormat='C2'}" Margin="0,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Paid Date:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PaidDate, StringFormat='MM/dd/yyyy HH:mm'}" Margin="0,5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Payment Reference:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PaymentReference}" Margin="0,5"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Approved By:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ApprovedBy.FullName}" Margin="0,5"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Supplier:" FontWeight="Bold" Margin="0,5"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Invoice.Order.Supplier.CompanyName}" Margin="0,5"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Width="80" Height="30" 
                HorizontalAlignment="Center" Margin="0,20,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>