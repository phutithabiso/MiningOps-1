<Window x:Class="MiningOps.Dialogs.SupplierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MiningOps.Converters"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}" Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" 
                   Foreground="#333333" Margin="0,0,0,20"/>

        <!-- Form with ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Company Information -->
                <GroupBox Header="Company Information" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Company Name*" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding Supplier.CompanyName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Contact Person*" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding Supplier.ContactPerson, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Address" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBox Text="{Binding Supplier.Address, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- User Account Selection -->
                <GroupBox Header="User Account" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Select Existing User*" FontWeight="SemiBold" Foreground="#333333"/>
                        <ComboBox ItemsSource="{Binding AvailableUsers}"
                                  DisplayMemberPath="Username"
                                  SelectedValuePath="AccId"
                                  SelectedValue="{Binding Supplier.AccId}"/>

                        <!-- Simple user info display -->
                        <TextBlock Text="Selected User:" FontWeight="SemiBold" Foreground="#333333" Margin="0,10,0,5"/>
                        <TextBlock Text="{Binding SelectedUser.FullName}" FontStyle="Italic"
                                   Visibility="{Binding SelectedUser, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding SelectedUser.Email}" FontSize="11" Foreground="#666666"
                                   Visibility="{Binding SelectedUser, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Permissions -->
                <GroupBox Header="Permissions" Padding="10">
                    <StackPanel>
                        <CheckBox Content="Can View Orders" IsChecked="{Binding Supplier.CanViewOrders}" 
                                  Margin="0,5"/>
                        <CheckBox Content="Can Manage Inventory" IsChecked="{Binding Supplier.CanManageInventory}" 
                                  Margin="0,5"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Background="#6C757D" Foreground="White" 
                    Click="CancelButton_Click"/>
            <Button Content="Save" Background="#1976D2" Foreground="White" 
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>